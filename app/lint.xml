<?xml version="1.0" encoding="UTF-8"?>
<!-- Advertencias de Android Lint revisadas a mano: cada excepción dice por qué -->
<lint>
    <!-- Mover los íconos adaptativos de mipmap-anydpi-v26 a mipmap-anydpi hace fallar a aapt con este AGP;
         con minSdk 26 ambas carpetas son equivalentes, así que no hay ningún efecto real. -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>
    <!-- Falso positivo: GoogleLogin.kt sí usa GoogleIdTokenCredential (createFrom y TYPE_GOOGLE_ID_TOKEN_CREDENTIAL)
         en la misma función; la regla no reconoce la comprobación con "is CustomCredential". -->
    <issue id="CredentialManagerSignInWithGoogle">
        <ignore path="src/main/java/com/timecapsule/app/data/GoogleLogin.kt" />
    </issue>
</lint>
